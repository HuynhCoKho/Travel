function route_(r){var a=r.action||'health';if(a==='health')return{version:'1.3.1',status:'ok'};authorize_(r.token);if(a==='setup')return setupSpreadsheet();if(a==='getExchangeRate')return exchangeRate_(r.from,r.to);if(a==='getUploadResult')return getUploadResult_(r.uploadId);if(a==='uploadExpenseAttachment')return uploadExpenseAttachment_(r.data||{});var e=r.entity?entity_(r.entity):'';if(a==='getSettings')return list_('settings',{});if(a==='getDashboard')return dashboard_(r.tripId);if(a==='list')return list_(e,r);if(a==='get')return get_(e,r.id);if(a==='create')return write_(e,function(){return create_(e,r.data||{})});if(a==='update')return write_(e,function(){return update_(e,r.data||{})});if(a==='delete')return write_(e,function(){return soft_(e,r.id,true)});if(a==='restore')return write_(e,function(){return soft_(e,r.id,false)});if(a==='duplicateTrip')return write_('trips',function(){return duplicateTrip_(r.id)});if(a==='getTripDetails'||a==='exportTrip')return tripDetails_(r.tripId||r.id);throw apiError_('INVALID_ACTION','Action không hợp lệ')}
function write_(entity,fn){var l=LockService.getScriptLock();if(!l.tryLock(3000))throw apiError_('LOCK_TIMEOUT','Hệ thống đang bận; hãy thử lại sau vài giây');try{var result=fn();clearDataCache_(entity);return result}finally{l.releaseLock()}}
